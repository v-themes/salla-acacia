{#
| Variable | Type | Description |
|------------------|---------|---------------------------------|
| cart | object | |
| cart.items_count | int | |
| cart.total | string | Formatted total ex: "١٠٠ ر.س" |
#}
<header class="store-header relative">
    {# Top Nav #}
    <div class="top-navbar hidden lg:block">
        <div class="container flex justify-between items-center">
            <div class="contact-tel">
                <salla-contacts data-testid="store-header-contacts" is-header></salla-contacts>
            </div>
            {# Language & Currency Component #}
            {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
            <div class="header-buttons">
                <salla-localization-modal></salla-localization-modal>
                <button type="button" onclick="salla.event.dispatch('localization::open')" class="btn--rounded-gray basis-0 gap-[6px] text-xs py-1 px-2.5">
                    <span class="block flag iti__flag iti__{{ user.language.country_code }} rounded-sm"></span>
                    <span>{{ currency.symbol }}</span>
                </button>
            </div>
            {% endif %}
        </div>
    </div>

    {# Main Nav #}
    <div id="mainnav" class="main-nav-container shadow-default bg-white !h-auto">
        <div class="inner bg-inherit py-2 lg:py-2.5">
            <div class="container">
                <div class="flex justify-between items-center w-full gap-2 lg:gap-4">
                    {# Mobile Burger Menu Button #}
                    <a class="lg:hidden mburger mburger--collapse leading-none block shrink-0" href="#mobile-menu" aria-label="Menu">
                        <i class="sicon-menu text-primary text-2xl"></i>
                    </a>

                    {# Store Brand Logo #}
                    <div class="navbar-brand-content flex-1 flex justify-center lg:justify-start lg:flex-initial shrink-0">
                        <a class="navbar-brand inline-flex items-center" href="{{ store.url }}">
                            <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ store.logo }}" alt="{{ store.name }}">
                            {% if is_page('index') %}
                            <h1 class="sr-only">{{ store.name }}</h1>
                            {% else %}
                            <h2 class="sr-only">{{ store.name }}</h2>
                            {% endif %}
                        </a>
                    </div>

                    {# Nav links (Categories Menu) #}
                    {% component 'header.menu' %}

                    {# User / Cart / Search Action Icons #}
                    <div class="flex items-center gap-1 sm:gap-2 shrink-0 justify-end">
                        {# user #}
                        <salla-user-menu avatar-only show-header show-trigger class="avatar-icon"></salla-user-menu>
                        {# Cart #}
                        <salla-cart-summary>
                            <i class="sicon-cart2"></i>
                        </salla-cart-summary>
                        {# Search #}
                        <button type="button" 
                                onclick="salla.event.dispatch('search::open')" 
                                class="header-search" 
                                data-testid="store-header-search-btn"
                                aria-label="{{ trans('blocks.header.search_placeholder') }}">
                            <i class="sicon-search"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>